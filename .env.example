DATABASE_URL=
# Canonical public URL of the deployed site.
# Used for metadataBase, sitemap/robots, notification links and Google OAuth.
NEXT_PUBLIC_SITE_URL=https://fadfed.vercel.app
# Legacy fallback for the site URL — prefer NEXT_PUBLIC_SITE_URL.
APP_URL=https://fadfed.vercel.app
# Set to true when served over HTTPS (required on Vercel production)
COOKIE_SECURE=
# Optional: enable "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Demo seeding: OFF by default in production, ON by default in dev.
# Set "true" to force demo data, "false" to disable everywhere.
AUTO_SEED=
# Supabase — public values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase — SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import in client components.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase DB password — migrations / direct Postgres connections only, server-side.
SUPABASE_DB_PASSWORD=
# Optional: demo seed account passwords (random ones are generated if unset)
SEED_DOCTOR_PASSWORD=
SEED_PATIENT_PASSWORD=

# ── Admin account ──────────────────────────────────────────────
# Doctor login seeded on startup (password is hashed, never stored plain).
# The account is created/updated whenever the app boots and these are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Comma-separated allow-list: ONLY these emails can open /admin (every env).
# Defaults to mvp-example@gmail.com when unset.
ADMIN_EMAILS=

# ── Live sessions (Daily.co, free plan) ────────────────────────
# SERVER ONLY — never prefix with NEXT_PUBLIC_, never log it.
# Create a key in the Daily dashboard (Developers → API keys). If empty,
# live sessions fall back to the manual link the doctor pastes.
DAILY_API_KEY=

# ── Video uploads (Cloudinary, free plan) ──────────────────────
# Direct browser→Cloudinary uploads for /admin/videos: the server only
# signs upload params; files never pass through Next.js. The API secret
# is SERVER ONLY — never prefix it with NEXT_PUBLIC_, never log it.
# If any of these are empty, the admin falls back to YouTube/Vimeo links.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
